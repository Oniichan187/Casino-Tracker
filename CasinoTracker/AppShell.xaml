<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CasinoTracker.Views"
       x:Class="CasinoTracker.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="Casino Tracker">

    <TabBar>
        <ShellContent Title="Session"
                      Icon="tab_home.png"
                      Route="main"
                      ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="Sessions"
                      Icon="tab_sessions.png"
                      Route="sessions"
                      ContentTemplate="{DataTemplate views:SessionsPage}" />
        <ShellContent Title="Statistics"
                      Icon="tab_stats.png"
                      Route="statistics"
                      ContentTemplate="{DataTemplate views:StatisticsPage}" />
        <ShellContent Title="Settings"
                      Icon="tab_settings.png"
                      Route="settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
