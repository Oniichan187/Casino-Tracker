<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CasinoTracker.ViewModels"
             xmlns:items="clr-namespace:CasinoTracker.ViewModels.Items"
             x:Class="CasinoTracker.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ContentPage.Resources>
        <DataTemplate x:Key="CasinoRow" x:DataType="items:ListEntry">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditCasinoCommand, x:DataType=vm:SettingsViewModel}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" IsVisible="{Binding HasSubtitle}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="›" FontSize="22" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MenuitemRow" x:DataType="items:ListEntry">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditMenuitemCommand, x:DataType=vm:SettingsViewModel}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" IsVisible="{Binding HasSubtitle}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="›" FontSize="22" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GameRow" x:DataType="items:ListEntry">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditGameCommand, x:DataType=vm:SettingsViewModel}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <Label Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="›" FontSize="22" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="Dark mode" FontAttributes="Bold" />
                            <Label Text="Use a dark colour scheme." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsDarkMode}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Session -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sessions" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Automatic stop" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding AutoStopHours, StringFormat='{0:0} h'}" FontAttributes="Bold" FontSize="16" />
                    </Grid>
                    <Slider Minimum="{Binding MinAutoStopHours}" Maximum="{Binding MaxAutoStopHours}" Value="{Binding AutoStopHours}" />
                    <Grid ColumnDefinitions="*,*">
                        <Label Text="4 h" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" Text="24 h" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                    </Grid>
                    <Label Text="{Binding AutoStopText}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Casinos -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Casinos" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Add" Command="{Binding AddCasinoCommand}" Style="{StaticResource LinkButton}" />
                    </Grid>
                    <Label Text="No casinos yet." Style="{StaticResource Caption}" IsVisible="{Binding HasCasinos, Converter={StaticResource InvertedBool}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Casinos}" BindableLayout.ItemTemplate="{StaticResource CasinoRow}" />
                </VerticalStackLayout>
            </Border>

            <!-- Menu items -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Menu items" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Add" Command="{Binding AddMenuitemCommand}" Style="{StaticResource LinkButton}" />
                    </Grid>
                    <Label Text="No menu items yet." Style="{StaticResource Caption}" IsVisible="{Binding HasMenuitems, Converter={StaticResource InvertedBool}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Menuitems}" BindableLayout.ItemTemplate="{StaticResource MenuitemRow}" />
                </VerticalStackLayout>
            </Border>

            <!-- Games -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Games" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Add" Command="{Binding AddGameCommand}" Style="{StaticResource LinkButton}" />
                    </Grid>
                    <Label Text="No games yet." Style="{StaticResource Caption}" IsVisible="{Binding HasGames, Converter={StaticResource InvertedBool}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Games}" BindableLayout.ItemTemplate="{StaticResource GameRow}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="8" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
